# =============================================================================
#  ~/kokli/.env.local on the server — the app's production settings
# =============================================================================
#  deploy/server/bootstrap.sh writes the real file from this one, replacing each
#  placeholder value below with a freshly generated secret, mode 600. Never in
#  git, never in the image, never in Jenkins. Check it at any time — it prints
#  key names and verdicts, never a value. The server has no Node of its own, so
#  the checker runs in a throwaway container:
#
#      docker run --rm -v ~/kokli/.env.local:/env:ro \
#        -v ~/kokli-src/deploy/server/check-env.js:/check.js:ro \
#        node:24-bookworm-slim node /check.js /env
#
#  FORMAT: KEY=value. No quotes, no spaces around =, comments on their own line.
#  Compose reads this file when the container is CREATED, so after any edit:
#
#      cd ~/kokli && docker compose up -d --no-build      (restart is not enough)
#
#  DELIBERATELY ABSENT — the image sets these, and overriding them breaks things:
#  NODE_ENV, PORT, HOSTNAME, KOKLI_VERSION, TZ (Asia/Kolkata, matching MySQL).
# =============================================================================

# ------------------------------------------------------------------- database
# kokli-mysql, the container from deploy/kokli-db, reached by its name over the
# kokli-internal network. Not 127.0.0.1, not localhost, not host.docker.internal.
DB_HOST=kokli-mysql
DB_PORT=3306
DB_USER=kokli
# The same value as MYSQL_PASSWORD in ~/kokli-db/.env. Hex: nothing in it needs
# quoting, and Compose would silently alter a $ in a value.
DB_PASSWORD=__DB_PASSWORD__
# Must be exactly this: database/schema.sql and seed.sql name it themselves.
DB_NAME=physio_clinic

# ------------------------------------------------------------------- platform
# Every absolute link, every email, the session cookie's domain (.kokli.in) and
# the Google callback come from these two. Lower case, nothing else around them,
# and decided once: changing the protocol later signs everybody out.
PLATFORM_DOMAIN=kokli.in
PLATFORM_PROTOCOL=https

# ------------------------------------------------------- secrets (generated)
# Signs session cookies, phone-login tickets and video-room tokens. Changing it
# signs everyone out.
AUTH_SECRET=__AUTH_SECRET__
# Encrypts every clinic's Razorpay and WhatsApp credentials. Must decode to
# exactly 32 bytes (openssl rand -base64 32). KEEP A COPY OFF THIS SERVER, in a
# password manager: lose or change it and every clinic has to reconnect both.
PLATFORM_ENCRYPTION_KEY=__PLATFORM_ENCRYPTION_KEY__
# Bearer token for the scheduled jobs. They run inside the container, so it never
# appears in the crontab.
CRON_SECRET=__CRON_SECRET__

# ---------------------------------------------------------------------- email
# Empty: every email is PRINTED to the container log and reported as sent — so
# password reset cannot work. Fill in before the first real clinic. 465 = TLS.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# A bare address on a domain the provider has verified (SPF, DKIM). No display name.
SMTP_FROM=no-reply@kokli.in

# ---------------------------------------------------- WhatsApp (Kokli's number)
# Empty: reminders are printed to the log, where no patient reads them, and phone
# sign-in is offered only by clinics whose plan lets them use their own number
# and that have connected one. Use a permanent System User token.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_API_VERSION=v21.0

# ------------------------------------------------------------- Google sign-in
# Empty: the button is hidden. In Google Cloud, register exactly
# https://kokli.in/api/auth/callback/google (clinics go through it too).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --------------------------------------------------------- TURN (video relay)
# Empty: calls behind strict NAT or firewalls do not connect. All three or none,
# and ONE url, e.g. turns:turn.example.com:443?transport=tcp
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# ------------------------------------------- Kokli's own billing (YOUR Razorpay)
# Empty: a clinic cannot subscribe (500), and renewals are never recorded.
# Live keys only (rzp_live_...) — test keys would hand out paid plans for free.
# Webhook: https://kokli.in/api/billing/webhook
PLATFORM_RAZORPAY_KEY_ID=
PLATFORM_RAZORPAY_KEY_SECRET=
PLATFORM_RAZORPAY_WEBHOOK_SECRET=

# -------------------------------------------------------------------- backups
# How many nightly dumps ~/kokli/backups keeps: 30 = a month of nights. Each
# deploy's own dump goes to ~/kokli/backups/predeploy instead, which keeps its
# newest ten (the deploy sets that itself), so deploys never push nightly
# history out.
BACKUP_KEEP=30

# ------------------------------------------------------ never set in this file
# AUTH_URL, NEXTAUTH_URL         break Google and phone sign-in on every clinic
# NEXTAUTH_SECRET                phone login and video read only AUTH_SECRET
# AUTH_TRUST_HOST, AUTH_REDIRECT_PROXY_URL   already set in auth.config.js
# EMAIL_DEBUG_HTML, DEBUG, NODE_DEBUG       print secrets and reset links to logs
# NODE_TLS_REJECT_UNAUTHORIZED              turns off TLS checks for SMTP, Razorpay, Meta
