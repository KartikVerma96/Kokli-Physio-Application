# =============================================================================
#  ~/kokli-db/.env on the server — the database's two passwords
# =============================================================================
#  bootstrap.sh writes the real file with freshly generated values and mode 600.
#  This example only shows the shape. Never commit real values.
#
#  MYSQL_PASSWORD is the `kokli` user's password, and must be the same value as
#  DB_PASSWORD in ~/kokli/.env.local. Hex, so it needs no quoting anywhere —
#  in env files, in mysqldump's defaults file, or on a command line.
# =============================================================================

MYSQL_ROOT_PASSWORD=generate-with-openssl-rand-hex-24
MYSQL_PASSWORD=generate-with-openssl-rand-hex-24
