# ============================================================================
#  ENVIRONMENT VARIABLES
# ============================================================================
#  Copy this file to .env.local and fill in your own values:
#
#      cp .env.example .env.local
#
#  .env.local is listed in .gitignore and must NEVER be committed — it holds
#  your database password and payment secret keys.
#
#  Anything starting with NEXT_PUBLIC_ is sent to the browser and is visible to
#  anyone who opens devtools. Everything else stays on the server. Never put a
#  secret behind a NEXT_PUBLIC_ prefix.
# ============================================================================


# ---------------------------------------------------------------- 1. DATABASE
# The same credentials you use to connect in MySQL Workbench.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=physio_clinic


# -------------------------------------------------------------------- 2. AUTH
# A random secret used to sign session cookies. If this leaks, anyone can forge
# a login. Generate one with:
#
#     openssl rand -base64 32
#
AUTH_SECRET=replace_this_with_a_long_random_string

# Do NOT set AUTH_URL. It makes next-auth treat every clinic subdomain as the
# root domain, which silently breaks Google sign-in from a clinic's website.
# Each hostname speaks for itself instead (trustHost in auth.config.js).
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ----------------------------------------------------------- 3. GOOGLE LOGIN
# How to get these (free, about three minutes):
#
#   1. Go to  https://console.cloud.google.com/apis/credentials
#   2. Create a project (or pick one), then: Create Credentials → OAuth client ID
#   3. Application type: Web application
#   4. Authorised JavaScript origins:
#          http://localhost:3000
#   5. Authorised redirect URIs — this must match EXACTLY, trailing slash and all:
#          http://localhost:3000/api/auth/callback/google
#   6. Copy the Client ID and Client Secret below.
#
# When you deploy, add your real domain to both lists too.
#
# Leave these blank and the app still works — the Google button simply hides
# itself and email/password login carries on as normal.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=


# ---------------------------------------------------------------- 4. PAYMENTS
# Razorpay test keys are free and instant — no company registration needed:
#
#   1. Sign up at  https://dashboard.razorpay.com/signup
#   2. Switch the dashboard toggle to  Test Mode
#   3. Settings → API Keys → Generate Test Key
#   4. The key id starts with rzp_test_
#
# In test mode use UPI id  success@razorpay  to simulate a successful payment,
# or card 4111 1111 1111 1111 with any future expiry and any CVV.
#
# The key id is safe in the browser (it only identifies your account).
# The key SECRET must never leave the server — it is what proves a payment
# confirmation genuinely came from Razorpay and was not forged by the user.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Used to verify Razorpay webhooks. Set it in Razorpay Dashboard →
# Settings → Webhooks, then paste the same value here. Optional for local
# development, essential in production.
RAZORPAY_WEBHOOK_SECRET=


# ----------------------------------------------------------- 5. VIDEO CALLING
# Video consultations use WebRTC, which connects the two browsers directly.
#
# STUN servers help each browser discover its own public address. Google's are
# free and fine for this.
#
# TURN is the fallback for the ~10% of patients behind restrictive corporate
# or mobile networks where a direct connection is impossible — the video is
# relayed through a server instead. Without TURN those calls fail to connect.
#
# Free TURN options: metered.ca/stun-turn (50GB/month free) or
# openrelay.metered.ca. Leave blank while developing on your own network.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=


# ------------------------------------------------------------------ 6. SERVER
PORT=3000

# ---------------------------------------------------------------- 7. PLATFORM
# The root domain everything hangs off.
#
#   {DOMAIN}                  your marketing site + signup
#   aarogya.{DOMAIN}          a clinic
#   {DOMAIN}/platform         your admin
#
# Leave it as `localhost` for development — browsers resolve *.localhost
# automatically, so aarogya.localhost:3000 works with no hosts-file editing.
#
# To go live: buy a domain, point a WILDCARD DNS record (*.yourdomain.com) at
# your server, and set this. Nothing else changes.
PLATFORM_DOMAIN=localhost
PLATFORM_PROTOCOL=http

# Encrypts each clinic's Razorpay secret before it is stored (AES-256-GCM).
# A leaked database must not hand an attacker the ability to move other
# businesses' money. Generate with:  openssl rand -base64 32
PLATFORM_ENCRYPTION_KEY=REPLACE_ME

# --------------------------------------------------- 8. PLATFORM BILLING
# YOUR Razorpay account — the one clinics pay their SUBSCRIPTION into.
#
# Completely separate from the per-clinic keys used for patient bookings, which
# each clinic enters themselves during onboarding. Do not reuse one for the other.
#
# Leave blank in development: subscriptions run in demo mode so the whole
# trial → paid journey can be walked through without a Razorpay account. Demo
# mode is hard-locked to non-production in lib/platformBilling.js.
PLATFORM_RAZORPAY_KEY_ID=
PLATFORM_RAZORPAY_KEY_SECRET=

# Razorpay Dashboard → Settings → Webhooks → https://yourdomain.com/api/billing/webhook
# Subscribe to: subscription.charged, subscription.halted, subscription.cancelled
PLATFORM_RAZORPAY_WEBHOOK_SECRET=

# Shared secret for the nightly status sweep (POST /api/cron/subscriptions).
# Generate with:  openssl rand -base64 32
CRON_SECRET=REPLACE_ME

# ------------------------------------------------------------------ 9. EMAIL
# Appointment confirmations, cancellations, trial reminders and receipts.
#
# LEAVE THIS BLANK AND EVERYTHING STILL WORKS. With no SMTP configured, every
# email is printed to the terminal instead of sent, so you can read the whole
# booking journey while developing without signing up to anything.
#
# For production, any SMTP provider does. Free tiers that are enough to start:
#   Brevo         300 emails/day     https://www.brevo.com
#   Resend        3,000/month        https://resend.com
#   Amazon SES    cheapest at volume
#
# Gmail works for testing with an App Password, but do not ship on it — it will
# rate-limit you and your mail will land in spam.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# The address emails are sent FROM. It must be on a domain you have verified
# with your provider, or SPF/DKIM will fail and everything lands in spam.
# The clinic's own name is used as the display name, and replies go to the
# clinic's own address — see lib/email.js.
SMTP_FROM=no-reply@yourdomain.com

# --------------------------------------------------------------- 10. WHATSAPP
# The feature that makes the subscription obvious: reminders halve no-shows, and
# Indian patients read WhatsApp rather than email.
#
# LEAVE BLANK AND EVERYTHING STILL WORKS. Every message prints to the terminal
# instead of sending, so the whole feature can be demonstrated to a clinic today
# — which matters, because Meta's approval takes days.
#
# GETTING THESE, IN ORDER:
#   1. business.facebook.com → create a Business account, then VERIFY it.
#      This is the slow part: 3–10 days. Start it before anything else.
#   2. developers.facebook.com → create an app → add "WhatsApp"
#   3. Add and verify the phone number that will send. It must NOT already be in
#      use on the normal WhatsApp or WhatsApp Business app.
#   4. Copy the Phone number ID and generate a PERMANENT token
#      (System User → Generate token. The default one expires in 24 hours and
#      will strand you on a Sunday.)
#   5. Submit the four templates:  npm run whatsapp:templates
#
# Cost is per conversation, not per message: roughly ₹0.11 for a utility
# conversation and ₹0.70 for marketing, both for 24 hours of messages.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=

# Any random string. Meta echoes it back when verifying the delivery webhook.
WHATSAPP_VERIFY_TOKEN=

# Pin the Graph API version so Meta deprecating one does not break sending
# unannounced.
WHATSAPP_API_VERSION=v21.0
